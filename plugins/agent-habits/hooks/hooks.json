{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/habits.py\" session-start" },
          { "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry/ensure_receiver.py\"", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/habits.py\" prompt" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/habits.py\" pre-tool" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Read|Grep|Glob|WebFetch|WebSearch",
        "hooks": [{ "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/habits.py\" post-tool" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/habits.py\" stop" }]
      }
    ]
  }
}
